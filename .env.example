# Required for Prisma CLI commands and future database access.
# Replace USER and PASSWORD with your local PostgreSQL role credentials.
# URL-encode special characters in credentials.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/anime_tracker?schema=public"

# Reserved for NextAuth v4; unused until authentication is implemented.
NEXTAUTH_URL="http://localhost:3000"
# Generate locally with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Reserved for future server-side AniList requests; no client is implemented.
ANILIST_API_URL="https://graphql.anilist.co"

# Future jobs only; not required and no Redis service or workers are configured.
# REDIS_URL="redis://localhost:6379"
